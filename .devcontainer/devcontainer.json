{
  "name": "dev environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/helpers4/devcontainer/vite-plus": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node": {
      "version": "26.1.0",
      "pnpmVersion": "11.0.9"
    },
    "ghcr.io/devcontainers/features/github-cli": "latest",
    "ghcr.io/joshuanianji/devcontainer-features/github-cli-persistence": true,
    "ghcr.io/ultranomic/devcontainer-features/opencode-persistence": {}
  },
  "remoteEnv": {
    "DO_NOT_TRACK": "1",
    "DISABLE_TELEMETRY": "1",
    "OPENCODE_EXPERIMENTAL_OXFMT": "true"
  },
  "onCreateCommand": "sudo chown -R vscode:vscode /workspaces/${localWorkspaceFolderBasename}",
  "postCreateCommand": "cat /workspaces/${localWorkspaceFolderBasename}/.devcontainer/post-create-commands.sh | bash",
  "customizations": {
    "vscode": {
      "extensions": [
        "aaron-bond.better-comments",
        "ms-azuretools.vscode-docker",
        "-dbaeumer.vscode-eslint",
        "Wattenberger.footsteps",
        "eamodio.gitlens",
        "Cardinal90.multi-cursor-case-preserve",
        "TypeScriptTeam.native-preview",
        "oxc.oxc-vscode",
        "oderwat.indent-rainbow",
        "usernamehw.errorlens",
        "YoavBls.pretty-ts-errors",
        "ms-vscode-remote.remote-containers",
        "yzhang.markdown-all-in-one",
        "sburg.vscode-javascript-booster",
        "github.vscode-github-actions",
        "VoidZero.vite-plus-extension-pack"
      ]
    }
  }
}
