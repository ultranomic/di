    "@ultranomic/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "4.1.5",
    "hono": "4.12.16",
    "typescript": "6.0.3",
    "vitest": "4.1.5",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@orpc/server": "^1.14.0",
    "@ultranomic/di-hono": "workspace:*"
  },
  "peerDependenciesMeta": {
