{
  "name": "@ultranomic/di",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal, type-safe dependency injection library built on class mixins",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start:dev": "node --watch ./examples/index.ts",
    "build:lib": "tsgo --noCheck",
    "build:dev": "pnpm run build:lib --declaration --declarationMap --removeComments false",
    "test:dev": "vitest dev",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260430.1",
    "@ultranomic/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "4.1.5",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
