{
  "chat.agent.enabled": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.inlineSuggest.edits.showCollapsed": true,
  "editor.linkedEditing": true,
  "editor.mouseWheelZoom": true,
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "editor.stickyTabStops": true,
  "editor.wordBasedSuggestions": "off",
  "editor.wordWrap": "on",
  "eslint.enable": false,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "js/ts.experimental.useTsgo": true,
  "js/ts.format.enabled": false,
  "js/ts.implementationsCodeLens.enabled": true,
  "js/ts.implementationsCodeLens.showOnInterfaceMethods": true,
  "js/ts.preferences.importModuleSpecifier": "project-relative",
  "js/ts.preferences.importModuleSpecifierEnding": "js",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.preferGoToSourceDefinition": true,
  "js/ts.referencesCodeLens.enabled": true,
  "js/ts.referencesCodeLens.showOnAllFunctions": true,
  "js/ts.suggest.completeFunctionCalls": true,
  "js/ts.suggestionActions.enabled": true,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "json.schemaDownload.enable": true,
  "json.schemaDownload.trustedDomains": {
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://models.dev/": true,
    "https://opencode.ai/": true,
    "https://raw.githubusercontent.com/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true
  },
  "npm.scriptRunner": "vp",
  "oxc.enable": true,
  "oxc.fmt.configPath": "./vite.config.ts",
  "oxc.requireConfig": true,
  "oxc.typeAware": true,
  "oxc.unusedDisableDirectives": "warn",
  "prettier.enable": false,
  "scm.defaultViewMode": "tree",
  "terminal.integrated.suggest.enabled": true,
  "workbench.commandPalette.experimental.enableNaturalLanguageSearch": true,
  "workbench.commandPalette.experimental.suggestCommands": true,
  "typescript.native-preview.tsdk": "/workspaces/di/node_modules/@typescript/native-preview"
}
